        {
          "name": "01 - Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.accessToken);",
                  "var suffix = Date.now().toString().slice(-6);",
                  "pm.collectionVariables.set('runSuffix', suffix);",
                  "pm.collectionVariables.set('secondaryAdminUsername', 'admin' + suffix);",
                  "pm.collectionVariables.set('secondaryAdminEmail', 'admin' + suffix + '@gym.local');",
                  "pm.collectionVariables.set('operatorUsername', 'operador' + suffix);",
                  "pm.collectionVariables.set('operatorEmail', 'operador' + suffix + '@gym.local');",
                  "pm.collectionVariables.set('categoryCode', 'SUP' + suffix);",
                  "pm.collectionVariables.set('categoryName', 'Suplementos ' + suffix);",
                  "pm.collectionVariables.set('categoryUpdatedName', 'Suplementos Premium ' + suffix);",
                  "pm.collectionVariables.set('productSku', 'PROT-' + suffix);",
                  "pm.collectionVariables.set('productName', 'Proteina Whey ' + suffix);",
                  "pm.collectionVariables.set('productUpdatedName', 'Proteina Whey Premium ' + suffix);",
                  "pm.collectionVariables.set('reportFrom', new Date().toISOString());",
                  "pm.collectionVariables.set('reportTo', new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString());"
                ]
              }
            }
          ],
          "request": {
            "description": "- Debe salir 200\n- Debe devolver accessToken\n- Debe devolver username=admin\n- Debe devolver role=ROLE_ADMIN\n- Ademas inicializa variables dinamicas para el resto de la corrida",
